# Optional settings. The obsidian binary reads them from the process
# environment; to use this file:  cp .env.example .env && set -a && . ./.env && set +a

# KV-cache context length in tokens (default 16384, about 1.6 GB)
OBSIDIAN_MAX_LEN=16384

# Set to use the per-token mat-vec expert path instead of the grouped GEMM
# OBSIDIAN_NO_GEMM=1

# Set to disable batched prefill
# OBSIDIAN_NO_BATCH=1

# Validation scripts only
# HF_HOME=~/.cache/huggingface
# AIRLLM_PATH=/path/to/airllm/air_llm
